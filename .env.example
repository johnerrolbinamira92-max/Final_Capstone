# Private desktop/admin app only. Never commit real values.
# Relative paths resolve inside admin_portal/
DB_FILE=hfrc_local_archive.db
SUPABASE_URL=https://YOUR_PROJECT_REFERENCE.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_OR_PUBLISHABLE_KEY
SUPABASE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY

# Optional offline login bootstrap. Set a strong password in the private .env;
# SQLite stores only a salted PBKDF2 hash.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_DISPLAY_NAME=Offline Administrator
LOCAL_ADMIN_ROLE=admin
